# Rust/Tauri build output — regenerated by `npx tauri build`, ~1.4 GB
app/src-tauri/target/
app/node_modules/
app/dist/
app/dist-kk/

# Built installers — these belong in GitHub Releases, not the repo
*.exe
*.zip

# Windows shortcuts (machine-specific absolute paths)
*.lnk

# OS noise
Thumbs.db
desktop.ini

# pre-git version snapshots and any private editions — kept locally, not published
archive/
*-setup.zip

# Android project — regenerated by `npx tauri android init`, and its build output is huge
app/src-tauri/gen/
app/src-tauri/icons-kk/

# the package for ChatGPT is built by tools/theme-kit.py from design/theme-kit
FOR-CHATGPT-themes/

# ChatGPT's theme packages as delivered (large previews and full-size plates); what the app uses is in design/skin and design/theme-art
handoff/terminal-*/
