app/src-tauri/target/
app/node_modules/
app/dist/
app/dist-kk/

# Built installers — these belong in GitHub Releases, not the repo
*.exe
*.zip

# Windows shortcuts (machine-specific absolute paths)
*.lnk

# OS noise
Thumbs.db
desktop.ini

# pre-git version snapshots and any private editions — kept locally, not published
archive/
*-setup.zip
