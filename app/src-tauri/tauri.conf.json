{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OSRS Buddy",
  "mainBinaryName": "OSRS Buddy",
  "version": "2.1.0",
  "identifier": "com.joshf.osrsbuddy",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8124",
    "beforeBuildCommand": "npm run sync"
  },
  "app": {
    "windows": [
      {
        "title": "OSRS Buddy",
        "width": 1180,
        "height": 860,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}